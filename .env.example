# Copy this file to .env and adjust as needed.
# .env is gitignored and must never be committed — it's where real,
# deployment-specific values (paths, credentials) belong.
#
# The *_DIR paths below are CONTAINER-INTERNAL mount points used by the app.
# The actual host-side locations are set via the `volumes:` section of
# docker-compose.yml, not here — these vars just tell the app where to look
# *inside* the container.

# --- User/group ---

# UID/GID the container runs as, once entrypoint.sh drops root. Set these
# to match a user on your host so files written to the bind-mounted
# inbox/work/archive/output directories come out owned by you instead of
# the image's baked-in default (1000:1000) - same convention as
# linuxserver.io-style images (sonarr, etc.). Run `id` on your host to
# find your own UID/GID.
#PUID=1000
#PGID=1000

# --- Paths (container-internal; map these via docker-compose.yml volumes) ---

# Watched drop folder — new audiobooks placed here are auto-detected.
INBOX_DIR=/data/inbox

# Scratch space used during conversion. Kept separate from INBOX_DIR so the
# folder watcher never reacts to the app's own temporary/partial files.
WORK_DIR=/data/work

# Where original source files are moved after successful processing
# (only used when SOURCE_CLEANUP_MODE=archive).
ARCHIVE_DIR=/data/archive

# Where finished audiobooks are written (both OUTPUT_MODE values).
OUTPUT_DIR=/data/output

# App database and settings, persisted across container restarts.
CONFIG_DIR=/data/config

# --- Output behavior ---

# standalone: write a single self-tagged .m4b to OUTPUT_DIR, no folder
#             structure, no sidecar files.
# library:    build a folder using the templates below and move the file
#             into it; optionally writes sidecar files (see below).
OUTPUT_MODE=standalone

# Naming templates. Placeholders: {author} {title} {year} {series}
# {series_index} {narrator} {genre}. Wrap an optional section in square
# brackets to have it drop out entirely when the placeholder(s) inside are
# empty — e.g. a book with no series.
#
# IMPORTANT: since these contain a literal "#", they must be quoted here —
# an unquoted "#" starts a comment in .env files and silently truncates
# everything after it.

# Used only when OUTPUT_MODE=standalone.
STANDALONE_FILENAME_TEMPLATE="{author} - {title}[ ({series} #{series_index})]"

# Used only when OUTPUT_MODE=library. Example:
#   LIBRARY_FOLDER_TEMPLATE={author}/[{series}/]{year} - {title}[ - {series} #{series_index}]
#   LIBRARY_FILENAME_TEMPLATE={title} ({year})[ - {series} #{series_index}]
LIBRARY_FOLDER_TEMPLATE="{author}/[{series}/]{year} - {title}[ ({series} #{series_index})]"
LIBRARY_FILENAME_TEMPLATE="{title} ({year})[ ({series} #{series_index})]"

# Only meaningful when OUTPUT_MODE=library. Writes desc.txt (synopsis),
# reader.txt (narrator), and cover.jpg alongside the .m4b, for media
# server agents that read sidecar files instead of (or in addition to)
# embedded M4B tags.
WRITE_SIDECAR_FILES=false

# --- Source cleanup ---

# archive: move original source files to ARCHIVE_DIR after processing.
# delete:  remove original source files after processing.
# keep:    leave the original source files where they were found.
SOURCE_CLEANUP_MODE=archive

# Auto-purge window (in days) for files in ARCHIVE_DIR. 0 or unset = keep
# archived originals forever.
ARCHIVE_RETENTION_DAYS=30

# --- Workflow gating ---

# If true, skip the manual "confirm to start" step in the UI and begin
# processing new drop-ins immediately.
AUTO_START_PROCESSING=false

# If true, skip the metadata review step and auto-apply the top audnexus
# match instead of waiting for confirmation in the UI.
AUTO_CONFIRM_METADATA=false

# --- Conversion ---

# MP3->AAC transcodes always encode at the source's own bitrate - encoding
# higher can't add back quality that isn't there. This is just an
# informational floor (in kbps): sources below it still get converted, but
# the job log flags them so you know the source itself is low quality.
MIN_BITRATE_KBPS=128

# --- Metadata ---

# Named so alternate sources can be added later. Only "audnexus" exists today.
METADATA_SOURCE=audnexus

# --- Chapter silence-detection fallback ---
# Only used as a last resort, when no embedded chapters, audnexus chapter
# data, or source-file boundaries are available (see README for the full
# chapter-resolution priority order).

# Noise floor below which audio counts as "silence" for chapter-boundary
# detection (ffmpeg silencedetect's `noise` parameter).
SILENCE_THRESHOLD_DB=-30dB

# Minimum length (seconds) of a quiet gap to count as a candidate chapter break.
SILENCE_MIN_DURATION_SEC=1.5

# Minimum resulting chapter length (seconds). Candidate breaks closer
# together than this are merged, so it doesn't over-split on pauses
# mid-sentence.
SILENCE_MIN_CHAPTER_SEC=120

# --- Detection ---

# How long (seconds) a dropped-off item's size/mtime must stay unchanged
# before the watcher considers it fully written and queues it. Prevents
# partial downloads/copies from being picked up mid-transfer.
SETTLE_WINDOW_SEC=10

# --- Web UI ---

# none or basic. "none" is intended for a trusted LAN only — do not expose
# this tool directly to the internet.
WEB_UI_AUTH=none

# Only used when WEB_UI_AUTH=basic.
WEB_UI_USERNAME=
WEB_UI_PASSWORD=

# Port the web UI is served on, both inside the container and on the host
# (see docker-compose.yml's `ports:` mapping). Not read by the Python app
# itself - only entrypoint.sh (uvicorn's --port) and docker-compose.yml's
# own variable substitution consume this.
PORT=2012
