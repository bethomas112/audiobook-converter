# Env for the Docker-orchestrated e2e run (tests/e2e/run_e2e.py). Mirrors
# a real library-mode deployment (see .env.example for what each var
# does) so the e2e run exercises the same code paths a real user would.
INBOX_DIR=/data/inbox
WORK_DIR=/data/work
ARCHIVE_DIR=/data/archive
OUTPUT_DIR=/data/output
CONFIG_DIR=/data/config
OUTPUT_MODE=library
STANDALONE_FILENAME_TEMPLATE="{author} - {title}[ ({series} #{series_index})]"
LIBRARY_FOLDER_TEMPLATE="{author}/[{series}/]{year} - {title}[ ({series} #{series_index})]"
LIBRARY_FILENAME_TEMPLATE="{title} ({year})[ ({series} #{series_index})]"
WRITE_SIDECAR_FILES=true
SOURCE_CLEANUP_MODE=archive
ARCHIVE_RETENTION_DAYS=30
AUTO_START_PROCESSING=false
AUTO_CONFIRM_METADATA=false
MIN_BITRATE_KBPS=128
METADATA_SOURCE=audnexus
SILENCE_THRESHOLD_DB=-30dB
SILENCE_MIN_DURATION_SEC=1.5
SILENCE_MIN_CHAPTER_SEC=120
SETTLE_WINDOW_SEC=8
WEB_UI_AUTH=none
WEB_UI_USERNAME=
WEB_UI_PASSWORD=
PORT=2012
